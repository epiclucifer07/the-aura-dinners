{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered user profile with Google Auth and verified phone credentials",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID matching Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "User's full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's Google or contact email"
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL from Google account"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Verified telephone or mobile number"
        },
        "phoneVerified": {
          "type": "boolean",
          "description": "Whether the telephone number has passed SMS/OTP verification"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was registered"
        }
      },
      "required": ["userId", "email"]
    },
    "Reservation": {
      "title": "Dining Reservation",
      "description": "Table booking made by a patron for an Aura dining sanctuary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referenceNo": { "type": "string" },
        "userId": { "type": "string" },
        "guestName": { "type": "string" },
        "guestEmail": { "type": "string" },
        "guestPhone": { "type": "string" },
        "phoneVerified": { "type": "boolean" },
        "cityId": { "type": "string" },
        "cityName": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "serviceType": { "type": "string" },
        "guests": { "type": "number" },
        "diningArea": { "type": "string" },
        "occasion": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["referenceNo", "cityId", "date", "timeSlot", "guestName", "guestPhone"]
    },
    "TastingOrder": {
      "title": "Tasting Course Order",
      "description": "Curated tasting flight pre-order associated with a table reservation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "reservationRef": { "type": "string" },
        "guestName": { "type": "string" },
        "guestPhone": { "type": "string" },
        "phoneVerified": { "type": "boolean" },
        "cityId": { "type": "string" },
        "currency": { "type": "string" },
        "subtotal": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "guestName", "guestPhone", "cityId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles keyed by Auth UID"
    },
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/Reservation" },
      "description": "Table reservations booked across all sanctuaries"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/TastingOrder" },
      "description": "Tasting orders with phone number verification"
    }
  }
}
